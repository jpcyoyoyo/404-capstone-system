# Normalise line endings in the repository. Files that run on the Raspberry Pi must keep LF
# even when checked out on Windows, or bash fails with "bad interpreter" / "$'\r'".
* text=auto
*.sh text eol=lf
deploy/network/greenhouse-net text eol=lf
deploy/**/*.service text eol=lf
deploy/**/*.conf text eol=lf
deploy/**/*.acl text eol=lf
deploy/**/*.desktop text eol=lf
deploy/**/*.example text eol=lf
deploy/**/Caddyfile text eol=lf
controller/Dockerfile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf

# Binary
*.png binary
*.jpg binary
*.woff2 binary
*.ico binary
