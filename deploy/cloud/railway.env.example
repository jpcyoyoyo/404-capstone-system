# Variables for the API service on Railway (see deploy/cloud/RAILWAY.md).
# In Railway: API service → Variables → Raw Editor, paste these, then fill in the two secrets.
# Never commit the filled-in values or paste them into chats or screenshots.
#
# ${{MySQL.…}} are Railway reference variables: they read the MySQL service's own settings, so
# no database password is typed here. If your MySQL service has another name, change "MySQL".

GH_ROLE=cloud
GH_DATABASE_URL=mysql+pymysql://${{MySQL.MYSQLUSER}}:${{MySQL.MYSQLPASSWORD}}@${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?charset=utf8mb4

# Must equal GH_JWT_SECRET in /etc/greenhouse/greenhouse.env on the Pi,
# so the same accounts and sign-ins work on both paths.
GH_JWT_SECRET=SAME_VALUE_AS_THE_PI

# A new long random value (on the Pi: openssl rand -hex 32). The Pi is given the same value
# with `sudo ghctl cloud setup`.
GH_SYNC_TOKEN=CHANGE_ME_LONG_RANDOM

GH_CORS_ORIGINS=*
GH_MQTT_HOST=memory
# the port the API listens on; give the same port when generating the Railway domain
PORT=8000
