# Cloud replica settings (deploy/cloud/cloud.env). Keep this file private.
GH_DOMAIN=greenhouse.example.com

# MySQL container
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=greenhouse
MYSQL_USER=greenhouse
MYSQL_PASSWORD=CHANGE_ME_DB

# API (role cloud)
GH_ROLE=cloud
GH_DATABASE_URL=mysql+pymysql://greenhouse:CHANGE_ME_DB@mysql:3306/greenhouse?charset=utf8mb4
# so the same accounts and tokens work on both paths
GH_JWT_SECRET=SAME_VALUE_AS_THE_PI
# the Pi's GH_SYNC_TOKEN must match
GH_SYNC_TOKEN=CHANGE_ME_LONG_RANDOM
GH_CORS_ORIGINS=*
GH_MQTT_HOST=memory
