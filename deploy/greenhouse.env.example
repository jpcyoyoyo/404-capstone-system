# /etc/greenhouse/greenhouse.env — read by every greenhouse-* systemd unit.
# Copy, fill in, then: sudo chmod 600 /etc/greenhouse/greenhouse.env

GH_ROLE=controller
# pi = real GPIO; sim = simulator (bench without hardware)
GH_HAL=pi
GH_REGISTRY=/opt/greenhouse/contract/registry.yaml
GH_DATABASE_URL=mysql+pymysql://greenhouse:CHANGE_ME_DB@127.0.0.1:3306/greenhouse?charset=utf8mb4

GH_MQTT_HOST=127.0.0.1
GH_MQTT_PORT=1883
GH_MQTT_USERNAME=greenhouse
GH_MQTT_PASSWORD=CHANGE_ME_MQTT
# What the app connects to for live data. The API hands these to logged-in users.
# Leave the host as "auto" to use whatever address the app reached the API on.
GH_MQTT_WS_URL=ws://auto:9001
GH_MQTT_APP_USERNAME=app
GH_MQTT_APP_PASSWORD=CHANGE_ME_APP

# openssl rand -hex 32
GH_JWT_SECRET=CHANGE_ME_64_HEX_CHARS
GH_ACCESS_TOKEN_MINUTES=30
GH_REFRESH_TOKEN_DAYS=14
# Fallback label only; greenhouse-net reports the live mode (magso | router | hotspot)
GH_NETWORK_MODE=unknown
# serves the kiosk page at /kiosk
GH_WEB_ROOT=/opt/greenhouse/app/dist

# Cloud replica (leave empty until the VPS exists; sync then simply doesn't run)
GH_CLOUD_URL=
GH_SYNC_TOKEN=
GH_SYNC_INTERVAL_S=60
