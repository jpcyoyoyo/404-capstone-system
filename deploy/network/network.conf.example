# /etc/greenhouse/network.conf — read by setup-network.sh and greenhouse-net.
# The Pi tries the networks below in order of priority and, if none is in range,
# starts its own hotspot so the app and kiosk still work (Integration Plan §9.5).

# 1. MAgSO Wi-Fi (leave SSID empty if not available yet)
MAGSO_SSID=""
MAGSO_PSK=""

# 2. Team's dedicated router (fixed address for the Pi on this network)
ROUTER_SSID="GreenhouseNet"
ROUTER_PSK=""
ROUTER_STATIC_IP="192.168.50.10/24"
ROUTER_GATEWAY="192.168.50.1"

# 3. Pi hotspot (fallback). The app's default controller address is 10.42.0.1.
HOTSPOT_SSID="SmartGreenhouse"
HOTSPOT_PSK="CHANGE_ME_8_CHARS_MIN"

# Seconds to wait for a known network after boot before starting the hotspot,
# and how often (while on the hotspot) to look for a known network again.
WAIT_S=90
RETRY_S=300
